# Plantilla del .env del backend (Docs/13-operacion.md §2.1).
# Copiar a backend/.env para desarrollo. Nunca subir el .env real.
# El backend valida estas claves con Zod al arrancar y no inicia si falta una obligatoria.

# Solo para logs; el nombre comercial vive en la base
CLIENT_NAME=Desarrollo
PORT=3000

# PostgreSQL 18 local en Docker (contenedor mise-postgres, Docs/06 §3.3)
DATABASE_URL=postgresql://mise_dev_app:CAMBIAR@localhost:5433/mise_dev?connection_limit=5
# Rol de solo lectura del chatbot (esquema semantic); se crea más adelante
DATABASE_URL_RO=

# 64 bytes aleatorios, distinto por cliente. Generar con:
#   node -e "console.log(require('node:crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CAMBIAR

# trace | debug | info | warn | error (producción: warn)
LOG_LEVEL=debug

# Chatbot (opcional, Fase 2). AI_MODEL no tiene valor por defecto: lo indica RENGO (Docs/10 §2.1)
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
AI_MAX_TOKENS=800

# Dominio público (CORS y orígenes permitidos de Socket.IO)
PUBLIC_DOMAIN=localhost:5173

# Versión mínima del frontend aceptada
MIN_FRONTEND_VERSION=0.0.0
