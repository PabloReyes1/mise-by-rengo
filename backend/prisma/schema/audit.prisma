// Módulo audit (Docs/07 §4.7, RF-070, RF-255). Dueño: Deniscito.
// Solo INSERT: la migración quita UPDATE y DELETE al rol de la app (Docs/07).

model AuditLog {
  id           BigInt    @id @default(autoincrement())
  at           DateTime  @default(now()) @db.Timestamptz(6)
  clientAt     DateTime? @map("client_at") @db.Timestamptz(6)
  branchId     String?   @map("branch_id") @db.Uuid
  userId       String?   @map("user_id") @db.Uuid
  authorizedBy String?   @map("authorized_by") @db.Uuid
  deviceId     String?   @map("device_id") @db.Uuid
  ip           String?
  action       String
  entity       String?
  entityId     String?   @map("entity_id")
  before       Json?
  after        Json?
  reasonId     String?   @map("reason_id") @db.Uuid
  note         String?

  @@index([at])
  @@index([entity, entityId])
  @@index([userId])
  @@map("audit_log")
}
