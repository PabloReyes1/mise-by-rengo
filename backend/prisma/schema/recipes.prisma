// Módulo recipes: insumos, unidades, recetas y costeo (Docs/07 §4.6). Dueño: Deniscito; reasignado a
// Pablito (doc 17 §3.1, H3 #22). product_id, modifier_id, category_id y set_by sin relación de
// Prisma: el servicio valida que existan (como en cash y floor).
// Pendientes aditivos (SC-67): ingredient_unit_conversions, recipes.combo_option_id y sub-recetas (F2).

model Unit {
  id        String @id @db.Uuid
  /// kg, g, l, ml, u, oz (templates/seed/units.json)
  code      String @unique
  name      String
  /// MASS / VOLUME / COUNT
  dimension String

  @@map("units")
}

model UnitConversion {
  fromUnitId String  @map("from_unit_id") @db.Uuid
  toUnitId   String  @map("to_unit_id") @db.Uuid
  /// 1 from = factor × to (ej. kg→g = 1000)
  factor     Decimal @db.Decimal(18, 6)

  @@id([fromUnitId, toUnitId])
  @@map("unit_conversions")
}

model Ingredient {
  id              String   @id @db.Uuid
  name            String
  category        String?
  baseUnitId      String   @map("base_unit_id") @db.Uuid
  currentUnitCost Decimal  @default(0) @map("current_unit_cost") @db.Decimal(12, 4)
  active          Boolean  @default(true)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  costs IngredientCost[]
  lines RecipeLine[]

  @@map("ingredients")
}

/// Historial de costos con fecha de vigencia (RF-130). Sin compras ni existencias.
model IngredientCost {
  id           String   @id @db.Uuid
  ingredientId String   @map("ingredient_id") @db.Uuid
  unitCost     Decimal  @map("unit_cost") @db.Decimal(12, 4)
  validFrom    DateTime @default(now()) @map("valid_from") @db.Timestamptz(6)
  setBy        String   @map("set_by") @db.Uuid

  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@index([ingredientId, validFrom])
  @@map("ingredient_costs")
}

/// Receta de un producto o de un modificador (RF-132). computed_cost se recalcula al guardar la
/// receta y al cambiar el costo de un insumo (RF-138).
model Recipe {
  id           String    @id @db.Uuid
  productId    String?   @unique @map("product_id") @db.Uuid
  modifierId   String?   @unique @map("modifier_id") @db.Uuid
  isSubrecipe  Boolean   @default(false) @map("is_subrecipe")
  name         String
  yieldQty     Decimal   @default(1) @map("yield_qty") @db.Decimal(12, 3)
  yieldUnitId  String?   @map("yield_unit_id") @db.Uuid
  computedCost Decimal   @default(0) @map("computed_cost") @db.Decimal(12, 4)
  computedAt   DateTime? @map("computed_at") @db.Timestamptz(6)

  lines RecipeLine[]

  @@map("recipes")
}

model RecipeLine {
  id           String  @id @db.Uuid
  recipeId     String  @map("recipe_id") @db.Uuid
  ingredientId String? @map("ingredient_id") @db.Uuid
  /// Sub-recetas: F2 (RF-133)
  subrecipeId  String? @map("subrecipe_id") @db.Uuid
  quantity     Decimal @db.Decimal(12, 4)
  unitId       String  @map("unit_id") @db.Uuid
  wastePct     Decimal @default(0) @map("waste_pct") @db.Decimal(5, 2)
  sort         Int     @default(0)

  recipe     Recipe      @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient Ingredient? @relation(fields: [ingredientId], references: [id])

  @@index([recipeId])
  @@index([ingredientId])
  @@map("recipe_lines")
}

/// % de costo objetivo (RF-134): producto > categoría > restaurante (CLIENT).
model CostTarget {
  id                String  @id @db.Uuid
  /// CLIENT / CATEGORY / PRODUCT
  scope             String
  categoryId        String? @map("category_id") @db.Uuid
  productId         String? @map("product_id") @db.Uuid
  targetFoodCostPct Decimal @map("target_food_cost_pct") @db.Decimal(5, 2)
  /// PA-045: 0.50, 1.00 o 5.00
  roundingStep      Decimal @default(1.00) @map("rounding_step") @db.Decimal(12, 2)
  /// UP / NEAREST
  roundingMode      String  @default("UP") @map("rounding_mode")

  @@unique([scope, categoryId, productId])
  @@map("cost_targets")
}
