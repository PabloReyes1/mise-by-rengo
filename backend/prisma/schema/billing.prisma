// Módulo billing (Docs/07 §4.4, cuentas). Dueño: Pablito.
// En H1 solo nace la Cuenta 1 al abrir la mesa (RF-101). Descuentos y pagos llegan en H3;
// cash_register_id y shift_id quedan sin relación hasta que exista el módulo cash.

model Bill {
  id              String    @id @db.Uuid
  occupancyId     String    @map("occupancy_id") @db.Uuid
  name            String
  status          String    @default("ABIERTA")
  /// Folio de recibo, al cobrar
  folio           String?
  subtotal        Decimal   @default(0) @db.Decimal(12, 2)
  discountTotal   Decimal   @default(0) @map("discount_total") @db.Decimal(12, 2)
  tipPct          Decimal?  @map("tip_pct") @db.Decimal(5, 2)
  tipAmount       Decimal   @default(0) @map("tip_amount") @db.Decimal(12, 2)
  total           Decimal   @default(0) @db.Decimal(12, 2)
  paidAt          DateTime? @map("paid_at") @db.Timestamptz(6)
  paidBy          String?   @map("paid_by") @db.Uuid
  cashRegisterId  String?   @map("cash_register_id") @db.Uuid
  shiftId         String?   @map("shift_id") @db.Uuid
  reopenCount     Int       @default(0) @map("reopen_count")
  precheckCount   Int       @default(0) @map("precheck_count")
  /// NIT o CF (único punto de extensión FEL en el MVP)
  customerNit     String?   @map("customer_nit")
  customerTaxName String?   @map("customer_tax_name")
  ownerDeviceId   String    @map("owner_device_id") @db.Uuid
  createdDeviceId String    @map("created_device_id") @db.Uuid
  version         Int       @default(0)

  occupancy Occupancy   @relation(fields: [occupancyId], references: [id])
  items     OrderItem[]

  @@unique([folio])
  @@index([occupancyId])
  @@map("bills")
}

/// Pagos de una cuenta (Docs/07 §4.5, Docs/05 paso 11). H3 #19, reasignado a Deniscito.
model Payment {
  id              String   @id @db.Uuid
  billId          String   @map("bill_id") @db.Uuid
  methodId        String   @map("method_id") @db.Uuid
  /// Monto aplicado a la cuenta (sin el cambio)
  amount          Decimal  @db.Decimal(12, 2)
  /// Entregado por el cliente (solo efectivo)
  tendered        Decimal? @db.Decimal(12, 2)
  changeGiven     Decimal  @default(0) @map("change_given") @db.Decimal(12, 2)
  reference       String?
  /// Obligatorio si es efectivo: turno de la caja que recibe el dinero (PA-052)
  shiftId         String?  @map("shift_id") @db.Uuid
  /// APLICADO, REVERTIDO, EN_CONFLICTO
  status          String   @default("APLICADO")
  receivedBy      String   @map("received_by") @db.Uuid
  createdDeviceId String   @map("created_device_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([billId])
  @@index([shiftId])
  @@map("payments")
}

/// Descuento sobre una cuenta o un ítem, exactamente uno de los dos (Docs/07 §4.5)
model AppliedDiscount {
  id              String   @id @db.Uuid
  billId          String?  @map("bill_id") @db.Uuid
  orderItemId     String?  @map("order_item_id") @db.Uuid
  /// PCT o AMOUNT
  kind            String
  value           Decimal  @db.Decimal(12, 2)
  /// Monto calculado
  amount          Decimal  @db.Decimal(12, 2)
  reasonId        String   @map("reason_id") @db.Uuid
  appliedBy       String   @map("applied_by") @db.Uuid
  authorizedBy    String?  @map("authorized_by") @db.Uuid
  createdDeviceId String   @map("created_device_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([billId])
  @@index([orderItemId])
  @@map("applied_discounts")
}
