// Módulo orders: rondas enviadas a cocina y sus ítems (Docs/07 §4.4, Docs/08 §2.6). Dueño: Pablito.
// Los ids de productos, modificadores, combos, estaciones, usuarios y dispositivos no tienen relación
// de Prisma: son de otros módulos y los valida el servicio (igual que en floor, SC-46).
// Los estados y el folio único por sucursal llevan CHECK e índice a mano en la migración.

model Order {
  id              String    @id @db.Uuid
  occupancyId     String    @map("occupancy_id") @db.Uuid
  branchId        String    @map("branch_id") @db.Uuid
  stationId       String?   @map("station_id") @db.Uuid
  /// 1, 2, 3… (≥ 2 se imprime "ADICIONAL")
  roundNumber     Int       @map("round_number") @db.SmallInt
  /// Definitivo, del servidor (C-000123)
  folio           String?
  /// Temporal sin conexión (M3-0005)
  tempFolio       String?   @map("temp_folio")
  status          String    @default("ENVIADO")
  sentBy          String    @map("sent_by") @db.Uuid
  sentAt          DateTime  @map("sent_at") @db.Timestamptz(6)
  acceptedAt      DateTime? @map("accepted_at") @db.Timestamptz(6)
  acceptedBy      String?   @map("accepted_by") @db.Uuid
  readyAt         DateTime? @map("ready_at") @db.Timestamptz(6)
  readyBy         String?   @map("ready_by") @db.Uuid
  deliveredAt     DateTime? @map("delivered_at") @db.Timestamptz(6)
  deliveredBy     String?   @map("delivered_by") @db.Uuid
  deliveredAuto   Boolean   @default(false) @map("delivered_auto")
  syncedLate      Boolean   @default(false) @map("synced_late")
  printedAt       DateTime? @map("printed_at") @db.Timestamptz(6)
  printDeviceId   String?   @map("print_device_id") @db.Uuid
  createdDeviceId String    @map("created_device_id") @db.Uuid
  version         Int       @default(0)

  occupancy Occupancy   @relation(fields: [occupancyId], references: [id])
  items     OrderItem[]

  @@index([occupancyId])
  @@index([branchId, status, sentAt])
  @@map("orders")
}

model OrderItem {
  id                  String    @id @db.Uuid
  orderId             String    @map("order_id") @db.Uuid
  billId              String    @map("bill_id") @db.Uuid
  productId           String    @map("product_id") @db.Uuid
  productNameSnapshot String    @map("product_name_snapshot")
  /// Entero en el MVP
  quantity            Decimal   @db.Decimal(8, 2)
  unitPrice           Decimal   @map("unit_price") @db.Decimal(12, 2)
  /// Σ modificadores y extras de combo por unidad
  modifiersTotal      Decimal   @map("modifiers_total") @db.Decimal(12, 2)
  /// (unit_price + modifiers_total) × quantity
  lineTotal           Decimal   @map("line_total") @db.Decimal(12, 2)
  /// Costo teórico congelado (RF-139); llega con recetas
  unitCostSnapshot    Decimal?  @map("unit_cost_snapshot") @db.Decimal(12, 4)
  note                String?
  status              String    @default("ENVIADO")
  cancelledAt         DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancelledBy         String?   @map("cancelled_by") @db.Uuid
  authorizedBy        String?   @map("authorized_by") @db.Uuid
  cancelReasonId      String?   @map("cancel_reason_id") @db.Uuid
  cancelAfterReady    Boolean   @default(false) @map("cancel_after_ready")
  splitFromId         String?   @map("split_from_id") @db.Uuid
  readyAt             DateTime? @map("ready_at") @db.Timestamptz(6)
  createdDeviceId     String    @map("created_device_id") @db.Uuid
  version             Int       @default(0)

  order      Order                @relation(fields: [orderId], references: [id])
  bill       Bill                 @relation(fields: [billId], references: [id])
  splitFrom  OrderItem?           @relation("ItemSplits", fields: [splitFromId], references: [id])
  splits     OrderItem[]          @relation("ItemSplits")
  modifiers  OrderItemModifier[]
  components OrderItemComponent[]

  @@index([orderId])
  @@index([billId])
  @@map("order_items")
}

model OrderItemModifier {
  id           String   @id @db.Uuid
  orderItemId  String   @map("order_item_id") @db.Uuid
  modifierId   String   @map("modifier_id") @db.Uuid
  nameSnapshot String   @map("name_snapshot")
  priceDelta   Decimal  @map("price_delta") @db.Decimal(12, 2)
  costSnapshot Decimal? @map("cost_snapshot") @db.Decimal(12, 4)

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
  @@map("order_item_modifiers")
}

model OrderItemComponent {
  id           String   @id @db.Uuid
  orderItemId  String   @map("order_item_id") @db.Uuid
  comboGroupId String   @map("combo_group_id") @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  nameSnapshot String   @map("name_snapshot")
  priceDelta   Decimal  @map("price_delta") @db.Decimal(12, 2)
  costSnapshot Decimal? @map("cost_snapshot") @db.Decimal(12, 4)
  /// [{ modifierId, name, priceDelta }]
  modifiers    Json     @default("[]")

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
  @@map("order_item_components")
}

/// Folio definitivo por sucursal y tipo de documento (Docs/09 §5), con UPDATE … RETURNING
model FolioSequence {
  branchId  String @map("branch_id") @db.Uuid
  docType   String @map("doc_type")
  lastValue Int    @default(0) @map("last_value")

  @@id([branchId, docType])
  @@map("folio_sequences")
}
