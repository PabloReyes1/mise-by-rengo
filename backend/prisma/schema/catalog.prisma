// Módulo catalog (Docs/07 §4.3). Dueño: Deniscito.
// product_branch_prices (precio por sucursal) es F2 (RF-012): se agrega después.

model KitchenStation {
  id        String  @id @db.Uuid
  branchId  String  @map("branch_id") @db.Uuid
  name      String
  /// printer_id se agrega con core/print (las impresoras aún no existen)
  isDefault Boolean @default(false) @map("is_default")

  branch     Branch     @relation(fields: [branchId], references: [id])
  categories Category[]

  @@map("kitchen_stations")
}

model Category {
  id        String  @id @db.Uuid
  name      String
  parentId  String? @map("parent_id") @db.Uuid
  color     String?
  icon      String?
  sort      Int     @default(0)
  stationId String? @map("station_id") @db.Uuid
  active    Boolean @default(true)

  station  KitchenStation? @relation(fields: [stationId], references: [id])
  products Product[]

  @@map("categories")
}

model Media {
  id        String   @id @db.Uuid
  mime      String
  bytes     Bytes
  width     Int
  height    Int
  sha256    String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  products Product[]

  @@map("media")
}

model Product {
  id                 String   @id @db.Uuid
  categoryId         String   @map("category_id") @db.Uuid
  name               String
  shortDescription   String?  @map("short_description")
  sku                String   @unique
  price              Decimal  @db.Decimal(12, 2)
  isCombo            Boolean  @default(false) @map("is_combo")
  status             String   @default("ACTIVE")
  imageMediaId       String?  @map("image_media_id") @db.Uuid
  sort               Int      @default(0)
  costTargetOverride Decimal? @map("cost_target_override") @db.Decimal(5, 2)
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  category       Category              @relation(fields: [categoryId], references: [id])
  image          Media?                @relation(fields: [imageMediaId], references: [id])
  modifierGroups ProductModifierGroup[]
  comboGroups    ComboGroup[]
  comboOptions   ComboGroupOption[]

  @@index([categoryId])
  @@map("products")
}

model ModifierGroup {
  id        String  @id @db.Uuid
  name      String
  required  Boolean @default(false)
  minSelect Int     @default(0) @map("min_select")
  maxSelect Int     @default(1) @map("max_select")
  sort      Int     @default(0)

  modifiers Modifier[]
  products  ProductModifierGroup[]

  @@map("modifier_groups")
}

model Modifier {
  id         String  @id @db.Uuid
  groupId    String  @map("group_id") @db.Uuid
  name       String
  priceDelta Decimal @default(0) @map("price_delta") @db.Decimal(12, 2)
  status     String  @default("ACTIVE")
  sort       Int     @default(0)

  group ModifierGroup @relation(fields: [groupId], references: [id])

  @@index([groupId])
  @@map("modifiers")
}

model ProductModifierGroup {
  productId String @map("product_id") @db.Uuid
  groupId   String @map("group_id") @db.Uuid
  sort      Int    @default(0)

  product Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  group   ModifierGroup @relation(fields: [groupId], references: [id])

  @@id([productId, groupId])
  @@map("product_modifier_groups")
}

model ComboGroup {
  id             String @id @db.Uuid
  comboProductId String @map("combo_product_id") @db.Uuid
  name           String
  minSelect      Int    @default(1) @map("min_select")
  maxSelect      Int    @default(1) @map("max_select")
  sort           Int    @default(0)

  comboProduct Product            @relation(fields: [comboProductId], references: [id], onDelete: Cascade)
  options      ComboGroupOption[]

  @@index([comboProductId])
  @@map("combo_groups")
}

model ComboGroupOption {
  id           String  @id @db.Uuid
  comboGroupId String  @map("combo_group_id") @db.Uuid
  productId    String  @map("product_id") @db.Uuid
  priceDelta   Decimal @default(0) @map("price_delta") @db.Decimal(12, 2)
  isDefault    Boolean @default(false) @map("default")

  comboGroup ComboGroup @relation(fields: [comboGroupId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id])

  @@index([comboGroupId])
  @@map("combo_group_options")
}
