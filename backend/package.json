{
  "name": "@mise/backend",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "prisma generate",
    "typecheck": "prisma generate && tsc --noEmit -p tsconfig.json",
    "dev": "tsx watch --conditions=@mise/source src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "seed": "tsx --conditions=@mise/source src/seed-cli.ts",
    "migrate": "prisma migrate deploy",
    "pairing-code": "tsx --conditions=@mise/source src/pairing-code-cli.ts"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.8",
    "@fastify/rate-limit": "^11.2.2",
    "@mise/shared": "workspace:*",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "fastify": "^5.12.8",
    "fastify-plugin": "^6.0.1",
    "fastify-type-provider-zod": "^7.0.0",
    "jose": "^6.2.17",
    "pino": "^10.4.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "pino-pretty": "^13.2.0",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15"
  }
}
